@page "/survivors"
@using MyZombieProject.App.Models
@using MyZombieProject.App.Datalayer.Repositories
@using MyZombieProject.App.Shared
@using MyZombieProject.App.Components.Shared
@using MyZombieProject.App.Datalayer
@inject ISurvivorRepository SurvivorRepo
@inject IShelterRepository ShelterRepo
@inject DataFacade Facade
@rendermode InteractiveServer

<h1 class="retro-title">SURVIVOR DATABASE</h1>

<table class="retro-table">
    <thead>
        <tr>
            <th>NAME</th>
            <th>HEALTH</th>
            <th>AGE</th>
            <th>ASSIGNED SHELTER</th>
            <th>ACTIONS</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in survivors)
        {
            <tr>
                <td>@person.Name</td>
                <td>
                    <span style="color: @(person.Health < 30 ? "red" : "#33ff33")">
                        @person.Health%
                    </span>
                </td>
                <td>@person.Age</td>
                <td>@(person.Shelter?.Name ?? "WANDERER")</td>
                <td>
                    <button class="retro-btn" @onclick="() => PrepareEdit(person)">[ EDIT ]</button>

                    @if (person.Health < 100)
                    {
                        <button class="retro-btn" style="color: #ff00ff; border-color: #ff00ff;"
                                @onclick="() => HealSurvivor(person)">
                            [ MEDICINE ]
                        </button>
                    }

                    <button class="retro-btn" @onclick="() => DeleteSurvivor(person.Id)">[ REMOVE ]</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="retro-panel">
    <button class="retro-btn" @onclick="OpenModal">[ + ADD SURVIVOR ]</button>
</div>

<RetroModal IsOpen="@showAddModal" Title="REGISTER SURVIVOR" OnClose="CloseModal" OnConfirm="SaveSurvivor">
    <p>NAME:</p>
    <input type="text" class="retro-input" @bind="newSurvivor.Name" />

    <p>AGE:</p>
    <input type="number" class="retro-input" @bind="newSurvivor.Age" />

    <p>ASSIGN TO SHELTER:</p>
    <select class="retro-input" @bind="newSurvivor.ShelterId">
        <option value="">-- NO SHELTER (WANDERER) --</option>
        @foreach (var s in availableShelters)
        {
            <option value="@s.Id">@s.Name</option>
        }
    </select>
</RetroModal>

@code {
    private List<Survivor> survivors = new();
    private List<Shelter> availableShelters = new();
    private bool showAddModal = false;
    private Survivor newSurvivor = new Survivor();

    protected override void OnInitialized()
    {
        RefreshData();
    }

    private void RefreshData()
    {

        survivors = Facade.GetAllSurvivors();
        availableShelters = Facade.GetAllShelters();
    }

    void OpenModal()
    {
        newSurvivor = new Survivor();
        showAddModal = true;
    }

    void CloseModal() => showAddModal = false;

    void PrepareEdit(Survivor survivorToEdit)
    {
        newSurvivor = new Survivor
        {
			Id = survivorToEdit.Id,
			Name = survivorToEdit.Name,
			Age = survivorToEdit.Age,
			ShelterId = survivorToEdit.ShelterId
        };
        showAddModal = true;
    }

    void SaveSurvivor()
    {
        if (newSurvivor.Id == 0)
        {
            Facade.AddSurvivor(newSurvivor);
        }
        else
        {
            Facade.UpdateSurvivor(newSurvivor);
        }

        showAddModal = false;
        RefreshData();
    }

    void DeleteSurvivor(int id)
    {
        Facade.DeleteSurvivor(id);
        RefreshData();
    }

    private void HealSurvivor(Survivor person)
    {
        // 1. Kolla om vi har Medkits via din Facade eller Repository
        // (Om du inte har en metod för Supplies i Facaden än, kan vi fejka kollen
        // eller bara köra på HP-ändringen för demot imorgon!)

        if (person.Health < 100)
        {
            // 2. Uppdatera hälsan
            person.Health = Math.Min(100, person.Health + 25);

            // 3. Spara via din Facade (den har ju redan UpdateSurvivor!)
            Facade.UpdateSurvivor(person);

            // 4. Ladda om listan så siffran ändras på skärmen
            RefreshData();

            Console.WriteLine($"{person.Name} medicinerad!");
        }
    }
}