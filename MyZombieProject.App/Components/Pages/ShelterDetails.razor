@page "/shelter-details/{Id:int}"
@using MyZombieProject.App.Models
@using MyZombieProject.App.Datalayer
@inject DataFacade Facade
@inject NavigationManager Nav
@rendermode InteractiveServer

<h1 class="retro-title">SHELTER ANALYSIS: @(shelter?.Name ?? "LOADING...")</h1>

<div class="retro-panel">
    <button class="retro-btn" @onclick="GoBack">[ BACK TO LIST ]</button>
</div>

@if (shelter != null)
{
    <div class="retro-grid">
        <div class="retro-box">
            <h3>LOCATION & INFO</h3>
            <p>ID: #@shelter.Id</p>
            <p>GPS: @shelter.GpsCoordinates</p>
            <p>STATUS: OPERATIONAL</p>
        </div>

        <div class="retro-box">
            <h3>RESIDENT COUNT</h3>
            <p style="font-size: 2rem;">@shelter.Survivors.Count</p>
            <p>Registered Survivors</p>
        </div>
    </div>

    <h3 class="retro-title" style="font-size: 1.2rem; margin-top: 20px;">ASSIGNED PERSONNEL</h3>
    <table class="retro-table">
        <thead>
            <tr>
                <th>NAME</th>
                <th>AGE</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in shelter.Survivors)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Age</td>
                </tr>
            }
            @if (!shelter.Survivors.Any())
            {
                <tr>
                    <td colspan="2" style="text-align:center;">NO SURVIVORS ASSIGNED</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public int Id { get; set; }
    private Shelter? shelter;

    protected override void OnInitialized()
    {
        shelter = Facade.GetShelterById(Id);
    }

    void GoBack() => Nav.NavigateTo("/shelters");
}