@page "/shelters"
@using MyZombieProject.App.Models
@using MyZombieProject.App.Datalayer.Repositories
@using MyZombieProject.App.Shared
@using MyZombieProject.App.Components.Shared
@using MyZombieProject.App.Datalayer
@inject NavigationManager Nav
@inject DataFacade Facade
@rendermode InteractiveServer

<h1 class="retro-title">SHELTER REGISTRY</h1>

<div class="retro-panel">
    <p>> ACTIVE SHELTERS</p>
</div>

<table class="retro-table">
    <thead>
        <tr>
            <th>NAME</th>
            <th>LOCATION</th>
            <th>CAPACITY</th>
            <th>SURVIVORS</th>
            <th>ACTIONS</th>
        </tr>
    </thead>
    
    <tbody>
        @foreach (var shelter in shelters)
        {
            <tr>
                <td>@shelter.Name</td>
                <td>@shelter.GpsCoordinates</td>
                <td>--</td> @* Eftersom Capacity saknas i modellen än så länge *@
                <td>@shelter.Survivors.Count</td>
                
                <td class="actions-cell">
                    <button class="retro-btn" @onclick="() => ViewShelter(shelter.Id)">[ VIEW ]</button>
                    <button class="retro-btn" @onclick="() => PrepareEdit(shelter)">[ EDIT ]</button>
                    <button class="retro-btn" @onclick="() => DeleteShelter(shelter.Id)">[ REMOVE ]</button>
                </td>
                
            </tr>
        }
    </tbody>
</table>

<div class="retro-panel">
    <button class="retro-btn" @onclick="OpenAddModal">[ + ADD SHELTER ]</button>
</div>

<RetroModal IsOpen="@showModal"
            Title="@(editingShelter.Id == 0 ? "ADD NEW SHELTER" : "EDIT SHELTER")"
            OnClose="CloseModal"
            OnConfirm="SaveShelter">

    <p>SHELTER NAME:</p>
    <input type="text" class="retro-input" @bind="editingShelter.Name" />

    <p>LOCATION (GPS):</p>
    <input type="text" class="retro-input" @bind="editingShelter.GpsCoordinates" />
</RetroModal>

@code {
    private List<Shelter> shelters = new();
    private bool showModal = false;
    private Shelter editingShelter = new Shelter();

    protected override void OnInitialized()
    {
        RefreshData();
    }

    private void RefreshData()
    {
        shelters = Facade.GetAllShelters();
    }

    void OpenAddModal()
    {
        editingShelter = new Shelter(); // Nollställ för ny skapelse
        showModal = true;
    }

    void PrepareEdit(Shelter shelter)
    {
        editingShelter = shelter; // Ladda in befintlig data
        showModal = true;
    }

    void CloseModal() => showModal = false;

    void SaveShelter()
    {
        if (editingShelter.Id == 0)
        {
            Facade.AddShelter(editingShelter);
        }
        else
        {
            Facade.UpdateShelter(editingShelter);
        }

        showModal = false;
        RefreshData();
    }

    void DeleteShelter(int id)
    {
        Facade.DeleteShelter(id);
        RefreshData();
    }

    void ViewShelter(int id) => Nav.NavigateTo($"/shelter-details/{id}");
}

