@page "/shelters"

<h1 class="retro-title">SHELTER REGISTRY</h1>

<div class="retro-panel">
    <p>> ACTIVE SHELTERS</p>
</div>

<table class="retro-table">
    <thead>
        <tr>
            <th>NAME</th>
            <th>LOCATION</th>
            <th>CAPACITY</th>
            <th>SURVIVORS</th>
            <th>ACTIONS</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Alpha Base</td>
            <td>North Zone</td>
            <td>20</td>
            <td>15</td>
            <td>
                <button class="retro-btn">[ VIEW ]</button>
            </td>
        </tr>
        <tr class="critical">
            <td>Outpost Z</td>
            <td>East Sector</td>
            <td>10</td>
            <td>10</td>
            <td>
                <button class="retro-btn">[ VIEW ]</button>
            </td>
        </tr>
    </tbody>
</table>

<div class="retro-panel">
    <button class="retro-btn">[ + ADD SHELTER ]</button>
</div>

