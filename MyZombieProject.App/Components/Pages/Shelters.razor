@page "/shelters"
@using MyZombieProject.App.Models
@using MyZombieProject.App.Datalayer.Repositories
@using MyZombieProject.App.Shared
@using MyZombieProject.App.Components.Shared
@inject ShelterRepository ShelterRepo
@rendermode InteractiveServer

<h1 class="retro-title">SHELTER REGISTRY</h1>

<div class="retro-panel">
    <p>> ACTIVE SHELTERS</p>
</div>

<table class="retro-table">
    <thead>
        <tr>
            <th>NAME</th>
            <th>LOCATION</th>
            <th>CAPACITY</th>
            <th>SURVIVORS</th>
            <th>ACTIONS</th>
        </tr>
    </thead>
    
    <tbody>
        @foreach (var shelter in shelters)
        {
            <tr>
                <td>@shelter.Name</td>
                <td>@shelter.GpsCoordinates</td>
                <td>--</td> @* Eftersom Capacity saknas i modellen än så länge *@
                <td>@shelter.Survivors.Count</td>
                <td>
                    <button class="retro-btn">[ VIEW ]</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="retro-panel">
    <button class="retro-btn" @onclick="OpenModal">[ + ADD SHELTER ]</button>
</div>

<RetroModal IsOpen="@showAddModal" Title="ADD SHELTER" OnClose="CloseModal" OnConfirm="ConfirmAdd">
    <p>SHELTER NAME:</p>
    <input type="text" class="retro-input" @bind="newShelter.Name" />

    <p>GPS COORDINATES:</p>
    <input type="text" class="retro-input" @bind="newShelter.GpsCoordinates" placeholder="e.g. 58.39, 13.86" />
</RetroModal>

@code {
    private List<Shelter> shelters = new();
    private bool showAddModal = false;
    private Shelter newShelter = new Shelter();

    protected override void OnInitialized()
    {
        RefreshData();
    }

    private void RefreshData()
    {
        shelters = ShelterRepo.GetAllShelters();
    }

    void OpenModal()
    {
        newShelter = new Shelter();
        showAddModal = true;
    }

    void CloseModal() => showAddModal = false;

    void ConfirmAdd()
    {
        ShelterRepo.Add(newShelter);
        showAddModal = false;
        RefreshData();
    }
}

