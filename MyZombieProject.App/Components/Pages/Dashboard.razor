@page "/"
@page "/dashboard"
@using MyZombieProject.App.Models
@using MyZombieProject.App.Datalayer.Repositories
@using MyZombieProject.App.Datalayer
@inject DataFacade Facade
@rendermode InteractiveServer

<h1 class="retro-title">CLAN STATUS TERMINAL</h1>

<div class="retro-panel main-header">
    <div class="header-line">> SYSTEM STATUS: <span class="status-online">ONLINE</span></div>
    <div class="header-line">> DATE: @DateTime.Now.ToString("yyyy-MM-dd") | TIME: @DateTime.Now.ToString("HH:mm:ss")</div>
    <div class="header-line">> LOCATION: GOTHENBURG SECTOR-7</div>
</div>

<div class="dashboard-grid">
    @* --- RESOURCE MONITOR --- *@
    <div class="retro-box">
        <div class="box-header">[ RESOURCE MONITOR ]</div>
        <div class="box-content">
            @foreach (SupplyType type in Enum.GetValues(typeof(SupplyType)))
            {
                var total = GetSupplyTotal(type);
                <div class="resource-line">
                    <span class="res-name">@type:</span>
                    <span class="res-value">@total.ToString("D3")</span>
                    <span class="res-status @(total < 20 ? "crit" : "stable")">
                        @(total < 20 ? "[ CRITICAL ]" : "[ STABLE ]")
                    </span>
                </div>
            }
        </div>
    </div>

    @* --- BIOMETRIC DATA --- *@
    <div class="retro-box">
        <div class="box-header">[ BIOMETRIC DATA ]</div>
        <div class="box-content centered">
            <div class="big-population-number">@survivors.Count</div>
            <div class="sub-text">TOTAL SURVIVORS</div>
            <div class="age-split">
                ADULTS: @survivors.Count(s => s.Age >= 18) | YOUTH: @survivors.Count(s => s.Age < 18)
            </div>
        </div>
    </div>

    @* --- FACILITY OVERVIEW --- *@
    <div class="retro-box">
        <div class="box-header">[ FACILITY OVERVIEW ]</div>
        <div class="box-content">
            <div class="info-row"><span>SHELTERS:</span> <span class="highlight">@shelters.Count</span></div>
            <div class="info-row"><span>CAPACITY:</span> <span class="highlight">@((survivors.Count * 1.2).ToString("F0"))%</span></div>
            <div class="info-row"><span>PRIMARY:</span> <span class="highlight">@(shelters.OrderByDescending(s => s.Survivors.Count).FirstOrDefault()?.Name?.ToUpper() ?? "N/A")</span></div>
        </div>
    </div>
</div>

@* --- SYSTEM LOG (TODO: lägga in Supply Run händelser!) --- *@
<div class="retro-panel system-log">
    <p class="blink">> INCOMING SYSTEM MESSAGES...</p>
    <p>> Scanning for biological threats... [NONE FOUND]</p>
    <p>> Power grid stability: 87%</p>
    @if (AnyCritical())
    {
        <p class="warning-text">> ALERT: RESOURCE DEFICIT DETECTED. SEND SCAVENGERS IMMEDIATELY.</p>
    }
</div>

@code {
    private List<Supply> supplies = new();
    private List<Survivor> survivors = new();
    private List<Shelter> shelters = new();

    protected override void OnInitialized()
    {
        supplies = Facade.GetAllSupplies();
        survivors = Facade.GetAllSurvivors();
        shelters = Facade.GetAllShelters();
    }

    private int GetSupplyTotal(SupplyType type) =>
        supplies.Where(s => s.Type == type).Sum(s => s.AmountInStock);

    private bool AnyCritical() =>
        Enum.GetValues(typeof(SupplyType)).Cast<SupplyType>().Any(t => GetSupplyTotal(t) < 20);
}
