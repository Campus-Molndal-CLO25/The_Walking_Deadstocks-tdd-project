@page "/"
@page "/dashboard"

<h1 class="retro-title">CLAN STATUS TERMINAL</h1>

<div class="retro-panel">
    <p>> SYSTEM ONLINE</p>
    <p>> DATE: @DateTime.Now.ToString("yyyy-MM-dd")</p>
    <p>> TIME: @DateTime.Now.ToString("HH:mm:ss")</p>
</div>

<div class="retro-grid">
    <div class="retro-box">
        <h3>SUPPLIES</h3>
        <ul>
            <li>Food: 120 units</li>
            <li>Ammo: 340 units</li>
            <li>Medicine: 12 units <span class="warning">LOW</span></li>
        </ul>
    </div>

    <div class="retro-box">
        <h3>SURVIVORS</h3>
        <p>Total: 17</p>
        <p>Children: 3</p>
        <p>Adults: 14</p>
    </div>

    <div class="retro-box">
        <h3>SHELTERS</h3>
        <p>Active shelters: 3</p>
        <p>Largest: Alpha Base</p>
    </div>
</div>

<div class="retro-panel">
    <p class="blink">> WARNING: MEDICINE CRITICAL</p>
</div>

