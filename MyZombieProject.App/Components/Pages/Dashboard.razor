@page "/"
@page "/dashboard"
@using MyZombieProject.App.Models
@using MyZombieProject.App.Datalayer.Repositories
@using MyZombieProject.App.Datalayer
@inject DataFacade Facade
@rendermode InteractiveServer

<h1 class="retro-title">CLAN STATUS TERMINAL</h1>

<div class="retro-panel">
    <p>> SYSTEM ONLINE</p>
    <p>> DATE: @DateTime.Now.ToString("yyyy-MM-dd")</p>
    <p>> TIME: @DateTime.Now.ToString("HH:mm:ss")</p>
</div>

<div class="retro-grid">
    @* --- SUPPLIES BOX --- *@
    <div class="retro-box">
        <h3>SUPPLIES</h3>
        <ul class="retro-list">
            @foreach (SupplyType type in Enum.GetValues(typeof(SupplyType)))
            {
                var total = GetSupplyTotal(type);
                <li>
                    @type: @total units
                    @if (total < 20)
                    {
                        <span class="warning"> [!] LOW STOCK</span>
                    }
                </li>
            }
        </ul>
    </div>

    @* --- SURVIVORS BOX --- *@
    <div class="retro-box">
        <h3>SURVIVORS</h3>
        <p>Total: @survivors.Count</p>
        <p>Children: @survivors.Count(s => s.Age < 18)</p>
        <p>Adults: @survivors.Count(s => s.Age >= 18)</p>
    </div>

    @* --- SHELTERS BOX --- *@
    <div class="retro-box">
        <h3>SHELTERS</h3>
        <p>Active shelters: @shelters.Count</p>
        <p>Largest: @(shelters.OrderByDescending(s => s.Survivors.Count).FirstOrDefault()?.Name ?? "N/A")</p>
    </div>
</div>

@* @if (GetSupplyTotal(SupplyType.Medicine) < 20)
{
    <div class="retro-panel">
        <p class="blink">> WARNING: MEDICINE CRITICAL</p>
    </div>
} *@

@code {
    private List<Supply> supplies = new();
    private List<Survivor> survivors = new();
    private List<Shelter> shelters = new();

    protected override void OnInitialized()
    {
        supplies = Facade.GetAllSupplies();
        survivors = Facade.GetAllSurvivors();
        shelters = Facade.GetAllShelters();
    }

    private int GetSupplyTotal(SupplyType type)
    {
        return supplies.Where(s => s.Type == type).Sum(s => s.AmountInStock);
    }
}
