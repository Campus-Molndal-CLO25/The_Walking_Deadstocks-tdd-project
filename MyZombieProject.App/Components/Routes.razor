@using MyZombieProject.App
@using MyZombieProject.App.Shared
@* Se till att detta namespace matchar mappen där RetroLayout ligger *@
@rendermode InteractiveServer

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        @* <ApiKeyGate> *@ 
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(RetroLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        @* </ApiKeyGate> *@ 
    </Found>
    <NotFound>
        @* Använd samma Layout här som ovan *@
        <LayoutView Layout="@typeof(RetroLayout)">
            <p role="alert">TERMINAL ERROR: ADDRESS NOT FOUND.</p>
        </LayoutView>
    </NotFound>
</Router>

