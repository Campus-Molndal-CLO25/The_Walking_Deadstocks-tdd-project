@rendermode InteractiveServer

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <ApiKeyGate>
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MyZombieProject.Components.Layout.MainLayout)" />
        </ApiKeyGate>
    </Found>

    <NotFound>
        <LayoutView Layout="@typeof(MyZombieProject.Components.Layout.MainLayout)">
            <p>Sorry, nothing here.</p>
        </LayoutView>
    </NotFound>
</Router>
